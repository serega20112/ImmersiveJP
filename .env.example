APP_NAME=ImmersJP
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=1
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
SECRET_KEY=change-me
SESSION_SECRET=change-me-too
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=immersjp
POSTGRES_USER=immersjp
POSTGRES_PASSWORD=immersjp
DATABASE_URL=
REDIS_ENABLED=1
REDIS_REQUIRED=0
REDIS_URL=redis://localhost:6379/0
# HF_API_TOKEN: можно указать несколько токенов через запятую — они ротируются,
# исчерпанные уходят в кулдаун, далее следует фолбэк на OpenRouter.
HF_API_TOKEN=
HF_MODEL=zai-org/GLM-5.3-Flash
HF_PROVIDER=
HF_CARDS_MODEL=zai-org/GLM-5.3-Flash
HF_CARDS_TIMEOUT_SECONDS=20
HF_CARDS_RETRY_ATTEMPTS=1
# Партия из 5 карточек занимает около 1100 выходных токенов, запас берётся с учётом
# трёх примеров на карточку.
HF_CARDS_MAX_TOKENS=10000
HF_CARDS_CIRCUIT_OPEN_SECONDS=180
HF_MENTOR_MODEL=zai-org/GLM-5.3-Flash
HF_MENTOR_TIMEOUT_SECONDS=30
HF_SPEECH_MODEL=zai-org/GLM-5.3-Flash
HF_WORK_REVIEW_MODEL=zai-org/GLM-5.3-Flash
# HF_ADVICE_MODEL пусто — совет идёт на той же модели, что и HF_MODEL.
HF_ADVICE_MODEL=
HF_ADVICE_TIMEOUT_SECONDS=12
HF_ADVICE_RETRY_ATTEMPTS=1
HF_ADVICE_MAX_TOKENS=400
LLM_REQUEST_WINDOW_SECONDS=3600
LLM_TOKEN_COOLDOWN_SECONDS=300
TEXT_INPUT_LIMIT=500
EMAIL_VERIFICATION_EXPIRE_MINUTES=20
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
ELASTICSEARCH_ENABLED=0
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_LOG_INDEX=immersjp-logs
# Резервный провайдер включается только когда заданы обе переменные: ключ и модель.
# Если оставить OPENROUTER_MODEL пустым при непустом ключе, резерв молча не участвует.
# OPENROUTER_API_KEY: как и HF_API_TOKEN, принимает несколько ключей через запятую;
# исчерпанный баланс одного ключа не оставляет генерацию без резерва.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=
EMBEDDING_MODEL=text-embedding-ada-002
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=3
RAG_MIN_SCORE=0.4
RAG_EMBEDDING_CACHE_TTL_SECONDS=86400
LLM_MODEL=openai/gpt-oss-120b:free
FREETTS_URL=https://api.freetts.com/tts
FREETTS_API_KEY=
